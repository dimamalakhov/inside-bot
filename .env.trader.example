# Compose заменяет это значение внутренним именем Redis; localhost используется при запуске без Docker.
REDIS_HOST=127.0.0.1
# TCP-порт локального Redis для компонентов торгового узла (по умолчанию 6379).
REDIS_PORT=6379
# Номер логической базы Redis для Python-стримеров (по умолчанию 0).
REDIS_DB=0
# Имя очереди сигналов, которую читает Rust и при необходимости Python-движок (по умолчанию trade_queue).
REDIS_QUEUE=trade_queue
# Хеш Redis, который заполняет price_streamer.py (по умолчанию futures_tickers).
REDIS_TICKERS_HASH=futures_tickers
# Имя хеша балансов Redis для Rust (по умолчанию futures_balances).
REDIS_BALANCES_HASH=futures_balances
# Префикс ключей Redis с балансом аккаунта (по умолчанию balance:).
BALANCE_KEY_PREFIX=balance:
# Включает дедупликацию сигналов Rust через Redis (по умолчанию true).
REDIS_DEDUP=true
# Время блокировки повторного сигнала в секундах (по умолчанию 60).
DUPLICATE_SIGNAL_LOCK_SEC=60

# По умолчанию включён безопасный режим без отправки ордеров. Меняйте на false только после ручной проверки.
TRADE_DRY_RUN=true
# Режим Binance Futures для Rust (по умолчанию PROD); Python-стримеры в любом случае используют рабочие адреса.
TRADE_MODE=PROD
# Необязательный базовый URL Binance REST для Rust; оставьте пустым для значения по умолчанию в коде.
BINANCE_REST_URL=
# Необязательный URL Binance WebSocket API для Rust; оставьте пустым для значения по умолчанию в коде.
BINANCE_WS_API_URL=
# Включает тестовую сеть Binance только для Rust (по умолчанию false; Python-стримеры остаются на рабочей сети).
BINANCE_TESTNET=false
# Необязательный путь к JSON с API-ключами для Rust относительно корня проекта (по умолчанию config/api_keys.json).
API_KEYS_FILE=config/api_keys.json
# Окно подписи запросов Rust в миллисекундах (по умолчанию 5000).
RECV_WINDOW_MS=5000
# Тайм-аут запроса ордера Rust в миллисекундах (по умолчанию 3000).
ORDER_TIMEOUT_MS=3000

# Доля доступного баланса (0.3 означает 30%; по умолчанию 0.3; Rust также принимает 30 для 30%).
TRADE_ALLOCATION=0.3
# Целевой уровень фиксации прибыли в процентах (по умолчанию 0.3).
TP_PERCENT=0.3
# Уровень ограничения убытка в процентах (по умолчанию 0.3).
SL_PERCENT=0.3
# Проскальзывание лимитного ордера ограничения убытка в процентах (по умолчанию 0.5).
SL_LIMIT_SLIPPAGE_PERCENT=0.5
# Необязательная доля в базисных пунктах; если задана, заменяет TRADE_ALLOCATION.
# TRADE_ALLOCATION_BPS=
# Необязательный целевой уровень прибыли в базисных пунктах; если задан, заменяет TP_PERCENT.
# TP_PERCENT_BPS=
# Необязательный уровень ограничения убытка в базисных пунктах; если задан, заменяет SL_PERCENT.
# SL_PERCENT_BPS=
# Необязательное проскальзывание ордера ограничения убытка в базисных пунктах; если задано, заменяет SL_LIMIT_SLIPPAGE_PERCENT.
# SL_LIMIT_SLIPPAGE_BPS=

# UDP-порт, на котором Rust принимает пакеты узла Listener (по умолчанию 5005; разрешите вход только с IP Listener).
BRIDGE_PORT=5005
# Пересылает принятые UDP-сообщения в локальную очередь Redis торгового узла (по умолчанию false).
BRIDGE_FORWARD_REDIS=false
# Устаревший псевдоним BINANCE_TESTNET (необязательно).
# TESTNET=false
# Необязательный URL Redis; заменяет REDIS_HOST/PORT/DB только для Rust.
# REDIS_URL=
# Устаревшее альтернативное имя очереди, принимаемое только Rust; для общей настройки используйте REDIS_QUEUE.
# REDIS_QUEUE_NAME=
# Необязательный флаг вывода таблицы в price_streamer.py (по умолчанию false).
# DISPLAY_UPDATES=false
# Фильтр журналов Rust (по умолчанию info; примеры: info, debug, rust_trader=debug).
RUST_LOG=info

# Интервал обновления кэша Rust в миллисекундах (по умолчанию 100).
# TICKER_UPDATE_INTERVAL_MS=100
# Интервал обновления балансов Rust в миллисекундах (по умолчанию 500).
# BALANCE_UPDATE_INTERVAL_MS=500
# Максимально допустимый возраст цены в миллисекундах (по умолчанию 2000).
# MAX_TICKER_AGE_MS=2000
# Число запросов статуса исполнения ордера Rust и интервал между ними в миллисекундах (по умолчанию 10 и 150).
# FILL_POLL_ATTEMPTS=10
# FILL_POLL_INTERVAL_MS=150
