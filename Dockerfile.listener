FROM python:3.11-slim-bookworm AS dependencies

ENV VIRTUAL_ENV=/opt/venv
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && python -m venv "$VIRTUAL_ENV" \
    && "$VIRTUAL_ENV/bin/pip" install --no-cache-dir --upgrade pip \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
WORKDIR /app
COPY requirements_listener.txt ./
RUN pip install --no-cache-dir -r requirements_listener.txt

FROM python:3.11-slim-bookworm AS runtime
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --no-create-home app \
    && mkdir -p /app/sessions /app/logs \
    && chown -R app:app /app
WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
COPY --chown=app:app telegram_listener.py generate_session.py ./
COPY --chown=app:app utils ./utils
USER app
CMD ["python", "telegram_listener.py"]
