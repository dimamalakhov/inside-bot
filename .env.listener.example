# ID приложения Telegram с сайта https://my.telegram.org -> API development tools (обязательно, целое число).
PYROGRAM_API_ID=
# Хеш приложения Telegram с той же страницы (обязательно, храните в секрете; кавычки нужны только для спецсимволов).
PYROGRAM_API_HASH=
# Числовой ID канала или чата Telegram для прослушивания (обязательно, используйте текущий ID бота).
PYROGRAM_TARGET_CHAT=

# Адрес для локального запуска без Docker; Compose заменит его внутренним именем Redis.
REDIS_HOST=127.0.0.1
# TCP-порт Redis (обязательно, по умолчанию 6379).
REDIS_PORT=6379
# Список Redis для текста сигналов (обязательно; используйте имя trade_queue).
REDIS_QUEUE=trade_queue

# Для этой двухсерверной схемы укажите частный IP торгового узла в Токио; публичный IP используйте только при отсутствии маршрута VPC.
BRIDGE_HOST=
# Существующий UDP-порт приёмника Rust (обязательно, по умолчанию 5005).
BRIDGE_PORT=5005
