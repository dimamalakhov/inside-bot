[Unit]
Description=Rocket v2 - leverage / ISOLATED margin configuration (periodic)
After=network-online.target redis-server.service price_streamer.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/python3 __APP_DIR__/reset_account_config.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
