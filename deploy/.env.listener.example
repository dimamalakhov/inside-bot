# ============================================================
# Rocket v2 — Listener Node (.env), Ubuntu
# Скопируйте в <APP_DIR>/.env и отредактируйте.
# ============================================================

# --- Telegram: my.telegram.org -> API development tools ---
PYROGRAM_API_ID=1234567
PYROGRAM_API_HASH=0123456789abcdef0123456789abcdef
PYROGRAM_TARGET_CHAT=-1001234567890

# --- Redis (локальный; очередь и дедупликация) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_QUEUE=trade_queue

# --- Мост в Токио (UDP) ---
# Публичный IP торгового узла. Пусто = UDP не отправляется.
BRIDGE_HOST=
BRIDGE_PORT=5005
