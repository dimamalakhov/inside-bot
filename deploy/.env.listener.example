# ============================================================
# Rocket v2 — настройки узла Listener (.env), Ubuntu
# Скопируйте в <APP_DIR>/.env и заполните параметры.
# ============================================================

# --- Telegram: my.telegram.org -> API development tools ---
PYROGRAM_API_ID=1234567
PYROGRAM_API_HASH=0123456789abcdef0123456789abcdef
PYROGRAM_TARGET_CHAT=-1001234567890

# --- Локальный Redis (очередь и дедупликация) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_QUEUE=trade_queue

# --- UDP-мост в Токио ---
# IP торгового узла. Если оставить поле пустым, UDP-сообщения отправляться не будут.
BRIDGE_HOST=
BRIDGE_PORT=5005
