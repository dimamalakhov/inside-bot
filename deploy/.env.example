# ============================================================
# Rocket v2 — настройки торгового узла (.env), Ubuntu
# Скопируйте в <APP_DIR>/.env и заполните параметры.
# API-ключи аккаунтов находятся в config/api_keys.json.
# ============================================================

# --- Redis (стримеры и движок) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE=trade_queue
REDIS_TICKERS_HASH=futures_tickers

# Балансы: balance_streamer.py записывает значения в ключи "balance:<owner>".
BALANCE_KEY_PREFIX=balance:
# REDIS_BALANCES_HASH=futures_balances   # резервное устаревшее имя, необязательно

# --- Торговля ---
TRADE_ALLOCATION=0.3
TP_PERCENT=0.3
SL_PERCENT=0.3
SL_LIMIT_SLIPPAGE_PERCENT=0.5

# --- Bridge (Европа -> Токио, UDP) ---
BRIDGE_PORT=5005
BRIDGE_FORWARD_REDIS=false

# --- Безопасный запуск: сначала режим без ордеров, затем рабочий режим ---
BINANCE_TESTNET=false
TRADE_DRY_RUN=true

# --- Уровень журналирования Rust ---
RUST_LOG=info
